# Copy to /srv/tg2fedi/tg2fedi.env, fill in, chmod 600.
# Never commit the real tg2fedi.env: it holds secrets.

# Bot token from @BotFather
TG_TOKEN=123456:ABC-DEF...

# Channel: username without @ (public) or numeric id like -1001234567890
TG_CHANNEL=my_channel

# GoToSocial server address and an application token with the write scope
GTS_URL=https://example.social
GTS_TOKEN=...

# Post visibility: public, unlisted, private (followers only), direct
VISIBILITY=private

# Seconds of silence to wait after the last image of an album
ALBUM_WAIT=10

# markdown (default) or plain, if formatting misbehaves
FORMAT=markdown
