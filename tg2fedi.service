[Unit]
Description=Telegram channel -> GoToSocial
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /srv/tg2fedi/tg2fedi.py
EnvironmentFile=/srv/tg2fedi/tg2fedi.env
# a separate throwaway user; state lives in /var/lib/tg2fedi
DynamicUser=yes
StateDirectory=tg2fedi
Restart=always
RestartSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
